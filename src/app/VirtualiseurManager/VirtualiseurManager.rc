// Application icon (resource 1), shared with VirtualiseurVM.exe.
#include <winver.h>

1 ICON "Virtualiseur.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,3,0,0
PRODUCTVERSION 0,3,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040C04B0"
        BEGIN
            VALUE "CompanyName", "Virtualiseur"
            VALUE "FileDescription", "Virtualiseur - Gestionnaire de machines virtuelles"
            VALUE "FileVersion", "0.3.0"
            VALUE "InternalName", "VirtualiseurManager"
            VALUE "OriginalFilename", "VirtualiseurManager.exe"
            VALUE "ProductName", "Virtualiseur"
            VALUE "ProductVersion", "0.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x040C, 1200
    END
END
