// Window icon (resource 1), shared with the manager.
#include <winver.h>

1 ICON "..\\app\\VirtualiseurManager\\Virtualiseur.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040C04B0"
        BEGIN
            VALUE "CompanyName", "Virtualiseur"
            VALUE "FileDescription", "Virtualiseur - Moniteur de machine virtuelle"
            VALUE "FileVersion", "0.2.0"
            VALUE "InternalName", "VirtualiseurVM"
            VALUE "OriginalFilename", "VirtualiseurVM.exe"
            VALUE "ProductName", "Virtualiseur"
            VALUE "ProductVersion", "0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x040C, 1200
    END
END
